{
  "name": "dexter-ui",
  "version": "0.1.0-beta.1",
  "description": "Dexter UI Framework – CSS/JS framework for web and e‑mail",
  "main": "src/js/index.js",
  "scripts": {
    "dev": "vite",
    "build": "node Dexter-UI/scripts/build-css.mjs",
    "build:css": "node Dexter-UI/scripts/build-css.mjs",
    "lint": "eslint src/**/*.js && stylelint \"src/**/*.scss\"",
    "format": "prettier --write .",
    "test": "echo \"No tests yet\"",
    "prepare": "husky install"
  },
  "author": "Charles Corrêa",
  "license": "MIT",
  "devDependencies": {
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "vite": "^5.2.0",
    "sass": "^1.77.0",
    "less": "^4.2.0",
    "postcss": "^8.4.31",
    "autoprefixer": "^10.4.15",
    "htmx.org": "^1.9.6",
    "tailwindcss": "^3.4.0",
    "daisyui": "^4.7.0",
    "eslint": "^8.57.0",
    "stylelint": "^16.2.0",
    "prettier": "^3.3.2",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2"
  },
  "lint-staged": {
    "*.{js,scss}": [
      "eslint --fix",
      "stylelint --fix",
      "prettier --write"
    ]
  }
}
